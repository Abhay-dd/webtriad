# ─────────────────────────────────────────────────────────────
#  Triad Realty — Frontend Environment Template
#  Copy this file to .env.local and fill in real values.
#  .env.local is gitignored — never commit secrets.
# ─────────────────────────────────────────────────────────────

# Backend API base URL.
# Leave blank or omit to use the same origin as the React app (recommended for production).
# For local development when running `npm start` on port 3000, set this to the backend URL:
REACT_APP_BACKEND_URL=http://localhost:8000
