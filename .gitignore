# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ─── IDE and editors ────────────────────────────────────────────
.idea/
.vscode/

# ─── Dependencies ────────────────────────────────────────────────
node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─── Testing ────────────────────────────────────────────────────
/coverage

# ─── Next.js ────────────────────────────────────────────────────
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# ─── Production builds ──────────────────────────────────────────
/build
dist/
build/
frontend/build/
backend/frontend_build/

# ─── Environment and credential files ───────────────────────────
.env
.env.*
*.env
!.env.example
credentials.json
*token.json*
*credentials.json*
*.pem
*.key
.credentials

# ─── Local secrets and fallback stores ──────────────────────────
.jwt_secret
backend/.jwt_secret
db_store.json
backend/db_store.json

# ─── Logs and debug files ────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dump.rdb

# ─── System files ───────────────────────────────────────────────
.DS_Store
.gitconfig

# ─── Python ──────────────────────────────────────────────────────
__pycache__/
*pyc*
venv/
.venv/
*.ipynb

# ─── Development / scaffolding tools ─────────────────────────────
.emergent/
anaconda_projects/
memory/
chainlit.md
.chainlit
.ipynb_checkpoints/
.ac

# ─── Deployment ─────────────────────────────────────────────────
.vercel
netlify.toml

# ─── Archive files and large assets ─────────────────────────────
**/*.zip
**/*.tar.gz
**/*.tar
**/*.tgz
*.pack
*.deb
*.dylib

# ─── Build caches ────────────────────────────────────────────────
.cache/
