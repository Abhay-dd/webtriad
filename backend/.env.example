# ─────────────────────────────────────────────────────────────
#  Triad Realty — Backend Environment Template
#  Copy this file to .env and fill in real values.
#  .env is gitignored — never commit secrets.
# ─────────────────────────────────────────────────────────────

# Runtime environment: development | production
ENVIRONMENT=development

# JWT secret — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Must be at least 32 characters in production.
JWT_SECRET=change-me-in-production
JWT_EXPIRE_HOURS=24

# Default admin user credentials (seeded on first startup)
DEVELOPER_EMAIL=developer@triad.ae
DEVELOPER_PASSWORD=change-me

OWNER_EMAIL=owner@triad.ae
OWNER_PASSWORD=change-me

STAFF_EMAIL=normal@triad.ae
STAFF_PASSWORD=change-me

# MongoDB connection string (leave blank to use the JSON file store)
MONGO_URL=mongodb+srv://king8637g4ff_db_user:*****@triad-cluster.zfjhnni.mongodb.net/?retryWrites=true&w=majority&appName=triad-cluster
DB_NAME=triad_realty

# Reelly external listings API key (optional)
REELLY_API_KEY=
REELLY_API_BASE=https://search-listings-production.up.railway.app/v1

# Comma-separated list of allowed CORS origins for local development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Default organisation ID used during seeding
DEFAULT_ORG_ID=default-org

# How many projects to auto-generate if DB has fewer
TARGET_PROJECT_COUNT=100
